# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
#   Project Settings → API
#
# Both values are safe in client-side code and are meant to ship in the
# browser: the anon key carries no privileges beyond the public SELECT
# policies and `execute` on log_event (SPEC_database.md → Row Level Security).
#
# NEVER put the service_role key here or anywhere in frontend code — it
# bypasses RLS entirely (SPEC.md → Never).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The hostname the app is served from in production. Used by the client-side
# instrumentation guard, which logs events only when NODE_ENV is production
# AND the hostname matches — because `npm run dev` points at the production
# database, so without the guard local refreshes dominate the events table
# (SPEC_database.md → Client-side rules).
NEXT_PUBLIC_SITE_HOST=pogreb.net
