# web/.env.example -- copy to web/.env.local (gitignored) and fill from the
# Supabase dashboard: Project Settings -> API.
#
# Both values are safe in client-side code and are meant to ship in the
# browser: the anon key carries no privileges beyond the public SELECT
# policies and `execute` on log_event (SPEC_database.md -> RLS).
#
# NEVER put the service_role key here or anywhere in frontend code -- it
# bypasses RLS entirely (SPEC.md -> Never).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The hostname the app is served from in production. The instrumentation guard
# logs only when NODE_ENV is production AND the hostname matches -- because
# `npm run dev` points at the production database, so without the guard local
# refreshes would dominate the events table (SPEC_database.md -> Client-side
# rules). Leave this unset locally; an unset value means nothing is logged.
NEXT_PUBLIC_SITE_HOST=pogreb.net
